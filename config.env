PORT=3001
NODE_ENV=development

# Configuration Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre-email@gmail.com
EMAIL_PASS=votre-mot-de-passe-app
EMAIL_FROM=votre-email@gmail.com

# Configuration PostgreSQL (URL ou variables PGHOST, PGUSER, PGPASSWORD, PGDATABASE, PGPORT)
DATABASE_URL=postgresql://localhost:5432/smartcrm

# Authentification (OAuth Google + JWT)
JWT_SECRET=votre-secret-jwt-long-et-aleatoire
JWT_COOKIE_NAME=smartcrm_token
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://www.mysmartcrm.fr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL complète du callback BACKEND (obligatoire). Google redirige ici après login.
# Ex: http://localhost:3001/api/auth/google/callback (dev) ou https://votre-api.onrender.com/api/auth/google/callback (prod)
# Cette URL doit aussi être ajoutée dans Google Cloud Console > Credentials > Authorized redirect URIs
GOOGLE_CALLBACK_URL=